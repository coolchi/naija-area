# Naija Area production environment: TEMPLATE WITH PLACEHOLDERS ONLY. Copy to a private file, fill in, never commit the filled-in copy.
# Check a filled-in copy without starting anything:   node scripts/check-config.mjs --file deploy/naija-area.env --production
# Every value below that says CHANGE_ME or <...> is a decision or a secret that someone has to supply. Nothing here works until they do.
NODE_ENV=production
PORT=3000
HOST=127.0.0.1                      # 0.0.0.0 inside Docker (the compose file sets it); keep 127.0.0.1 with systemd + a local proxy
NA_TRUST_PROXY=1                    # number of proxies in front of the app (Caddy or nginx or the Cloudflare Tunnel = 1)
NA_PUBLIC_URL=https://CHANGE_ME     # the public https address, once a domain exists (DECISION: domain)
GAME_NAME=Naija Area                # DECISION: final name (see 08_naming_checks.md)

# ---- secrets (generate with: openssl rand -hex 32)
SESSION_SECRET=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME
# Second factor for /admin: run `node tools/admin-totp.mjs`, add the account to an authenticator app, keep the secret ONLY here and in the password manager.
ADMIN_TOTP_SECRET=CHANGE_ME
# Optional but recommended: comma-separated office/VPN IPs or IPv4 ranges (203.0.113.7,198.51.100.0/24). Everyone else gets a 404 for /admin and /api/admin.
NA_ADMIN_ALLOW_IPS=
# Optional: 24+ random characters so your monitor can read /metrics with 'Authorization: Bearer <token>'. Unset keeps /metrics admin-only.
# NA_METRICS_TOKEN=generate-a-long-random-value-here

# ---- data: SQLite file (default) or Postgres
NA_DATA_DIR=/var/lib/naija-area     # a persistent, backed-up disk
# NA_DATABASE_URL=postgres://naija:CHANGE_ME@127.0.0.1:5432/naija
# NA_DB_SSL=1                       # needed when the database is on another machine
# NA_DB_SINGLE_INSTANCE=1

# ---- payments: TEST MODE ONLY in this build (live keys are refused by the code)
NA_PAYMENTS_PROVIDER=monipay
MONIPAY_SECRET_KEY=pri_test_CHANGE_ME
MONIPAY_PUBLIC_KEY=pub_test_CHANGE_ME
MONIPAY_WEBHOOK_SECRET=CHANGE_ME
# NA_ADS_REQUIRE_PAYMENT=0

# ---- age check: no vendor chosen. off = the 18+ tick box only (NOT a real age check)
NA_AGE_CHECK=off
NA_AGE_PROVIDER=mock

# ---- optional
# NA_REAL_RADIO=0                   # global off switch for the four real radio stations
# NA_SCORES_PROVIDER=api-football   # needs APIFOOTBALL_KEY; the default is the fictional league
# APIFOOTBALL_KEY=
# NA_TURN_URLS=turn:turn.example.org:3478
# NA_TURN_USERNAME=
# NA_TURN_CREDENTIAL=
# CLOUDFLARE_TUNNEL_TOKEN=          # only for the compose "tunnel" profile
# POSTGRES_PASSWORD=                # only for the compose "postgres" profile
