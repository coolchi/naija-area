{
  "name": "naija-area",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Naija Area v0: browser-based multiplayer city life sim (ad-supported). Test mode only: no real payments.",
  "scripts": {
    "start": "node server/index.js",
    "build": "node tools/build-client.mjs",
    "seed": "node scripts/seed.js",
    "bots": "node scripts/bots.js",
    "test": "node --test --test-concurrency=1 tests/",
    "test:pg": "node scripts/pg-local.mjs run -- node --test --test-concurrency=1 tests/",
    "db:migrate": "node tools/pg-migrate.mjs",
    "smoke": "node scripts/e2e-smoke.mjs",
    "smoke:interiors": "node scripts/interiors-smoke.mjs",
    "smoke:phone": "node scripts/phone-smoke.mjs",
    "smoke:payments": "node scripts/payments-smoke.mjs",
    "smoke:age": "node scripts/age-smoke.mjs",
    "smoke:wordboard": "node scripts/wordboard-smoke.mjs",
    "smoke:signup": "node scripts/signup-smoke.mjs",
    "smoke:tutorial": "node scripts/tutorial-smoke.mjs",
    "smoke:mobile": "node scripts/mobile-smoke.mjs",
    "smoke:audio": "node scripts/audio-smoke.mjs",
    "smoke:missions": "node scripts/missions-smoke.mjs",
    "smoke:achievements": "node scripts/achievements-smoke.mjs",
    "smoke:admin": "node scripts/admin-smoke.mjs",
    "build:demo": "node tools/build-demo.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.5.0",
    "express": "^4.21.0",
    "pg": "^8.23.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "embedded-postgres": "^17.5.0-beta.15",
    "esbuild": "^0.25.0",
    "puppeteer-core": "^24.0.0",
    "sql.js": "^1.11.0",
    "three": "^0.170.0"
  }
}
